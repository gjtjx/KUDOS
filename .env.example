# local = deterministic offline demo; llm = remote function-calling model
AI_MODE=local
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_STYLE=chat_completions
LLM_TIMEOUT_SECONDS=90
LLM_TOOL_CHOICE=forced
LLM_STRICT_TOOLS=true
# Verified Poe Claude configuration (use .env.local for provider settings):
# AI_MODE=llm
# LLM_BASE_URL=https://api.poe.com/v1
# LLM_MODEL=claude-sonnet-5.5
# LLM_API_STYLE=chat_completions
# LLM_TOOL_CHOICE=auto
# LLM_STRICT_TOOLS=false
# Keep the real LLM_API_KEY in .env; neither local settings file is committed.
# DATABASE_PATH defaults to runtime/clinic.db
